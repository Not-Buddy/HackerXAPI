GEMINI_KEY=
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_embeddings
SERVER_PORT=8000
CHUNK_SIZE=8000
TOP_K=10
SIMILARITY_THRESHOLD=0.3
EMBED_MODEL=auto
LLM_MODEL=prompt
AUTO_DISCOVER_MODELS=true

# Storage: "local", "r2", or "prompt" (asks interactively)
# Leave empty/unset for interactive prompt at startup
STORAGE_BACKEND=prompt
STORAGE_LOCAL_DIR=./data/files

# Cloudflare R2 (only needed if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ragx-files
